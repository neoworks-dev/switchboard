{
  "name": "@neoworks/harness",
  "description": "One SDK for driving Claude Code, Codex and pi from any app, in-process or through a sidecar",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "private": true,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "neoworks-harness": "./dist/cli/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "cli": "node src/cli/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p .",
    "lint": "oxlint src tests scripts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^26.6.3",
    "@types/ws": "^8.18.1",
    "oxlint": "^1.85.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "^0.81.2",
    "@agentclientprotocol/codex-acp": "^1.13.1",
    "@agentclientprotocol/sdk": "^1.5.0",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "commander": "^15.0.0",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  }
}
